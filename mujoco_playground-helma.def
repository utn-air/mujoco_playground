Bootstrap: docker
From: ubuntu:24.04

%arguments
    # Override with --build-arg http_proxy=... if building elsewhere.
    http_proxy=http://proxy.rrze.uni-erlangen.de:80

%files
    mujoco_playground /opt/mujoco_playground

%environment
    export APPTAINER_CACHEDIR=/tmp
    export PYTHONUNBUFFERED=1
    export VIRTUAL_ENV=/opt/mujoco_playground/.venv
    export PATH=/opt/mujoco_playground/.venv/bin:/opt/uv-env/bin:$PATH
    export http_proxy=http://proxy.rrze.uni-erlangen.de:80
    export https_proxy=http://proxy.rrze.uni-erlangen.de:80
    export MUJOCO_GL=${MUJOCO_GL:-osmesa}

%post
    export http_proxy="{{ http_proxy }}"
    export https_proxy="{{ http_proxy }}"

    apt-get update -y
    apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        git \
        libegl1 \
        libgl1 \
        libglfw3 \
        libgomp1 \
        libosmesa6 \
        make \
        ninja-build \
        pkg-config \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv \
        libx11-6 \
        libxext6 \
        libxrender1 \
        libxrandr2 \
        libxi6 \
        libxinerama1 \
        libxcursor1 \
    && rm -rf /var/lib/apt/lists/*

    python3 -m venv /opt/uv-env
    /opt/uv-env/bin/pip install --no-cache-dir uv
    export UV_PYTHON_INSTALL_DIR=/opt/uv-python
    PATH=/opt/uv-env/bin:$PATH uv python install 3.13
    cd /opt/mujoco_playground
    CMAKE_CXX_STANDARD=17 PATH=/opt/uv-env/bin:$PATH \
        uv sync --python 3.13 --extra rl --group dev

    rm -rf /root/.cache

%runscript
    cd /opt/mujoco_playground
    exec "$@"
